{
  "name": "@todo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:check": "prisma db execute --file prisma/check.sql"
  },
  "dependencies": {
    "@todo/contracts": "0.1.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.0.0"
  }
}
